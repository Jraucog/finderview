{
  "name": "finderview",
  "version": "1.0.0",
  "description": "Blazing-fast, modern macOS file manager built with Electron",
  "main": "main.js",
  "license": "MIT",
  "keywords": [
    "macos",
    "file-manager",
    "finder",
    "electron",
    "productivity",
    "disk-management",
    "antigravity"
  ],
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir",
    "pack": "electron-builder --mac",
    "test": "npm run test:security",
    "test:security": "node --test tests/security.test.js"
  },
  "build": {
    "appId": "com.joe.finderview",
    "productName": "FinderView",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
